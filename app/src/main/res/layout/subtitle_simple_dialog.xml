<?xml version="1.0" encoding="utf-8"?>
<!-- YTindir: the download card's subtitles: on, YouTube's auto-translation, the languages and how they are saved -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/subs_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subs_download" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/subs_auto_translate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subs_auto_translate" />

        <TextView
            android:id="@+id/subs_auto_translate_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="56dp"
            android:text="@string/subs_auto_translate_summary"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/subs_languages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_languages"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/subs_languages_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <TextView
            android:id="@+id/subs_save_as_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subs_save_as"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <RadioGroup
            android:id="@+id/subs_save_as"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/subs_save_embed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subs_save_embed" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/subs_save_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subs_save_file" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/subs_save_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subs_save_both" />

        </RadioGroup>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
